<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lost & Found Tracker</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="<%= user && user.role === 'admin' ? 'admin-theme' : user && user.role === 'staff' ? 'staff-theme' : '' %>">
  <nav class="navbar">
    <div>
      <span class="brand">Lost &amp; Found Tracker</span>
      <% if (user) { %>
        <!-- No separate "Search" link — the search/filter bar is right on
             the Items page now (views/items/index.ejs), not a click away. -->
        <a href="/items">Items</a>
        <!-- Shown to everyone, not just students — reporting an item is
             open to any logged-in user (see POST /items/new in app.js). -->
        <a href="/items/mine">My Reports</a>
        <% if (user.role === 'student') { %>
          <a href="/claims/mine">My Claims</a>
        <% } %>
        <% if (user.role === 'staff' || user.role === 'admin') { %>
          <a href="/claims">Claims</a>
        <% } %>
        <% if (user.role === 'admin') { %>
          <a href="/admin/users">Users</a>
        <% } %>
      <% } %>
    </div>
    <div>
      <% if (user) { %>
        <a href="/profile">Hi, <%= user.username %> (<%= user.role %>)</a>
        <form action="/logout" method="POST" style="display:inline;">
          <button type="submit" class="btn" style="margin-left:1rem;">Log out</button>
        </form>
      <% } else { %>
        <a href="/login">Log in</a>
        <a href="/register">Register</a>
      <% } %>
    </div>
  </nav>
  <div class="container">
