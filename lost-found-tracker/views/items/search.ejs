<%- include('../partials/header') %>
  <!-- Jun Hao — Search & Filter, split into its own route/view (was
       merged into Hui Xing's /items page). + Autocomplete (native
       <datalist>, zero client-side JS) & Recent Searches. -->
  <h1>Search Items</h1>

  <form class="filters" action="/items/search" method="GET">
    <input type="text" name="q" list="item-names" placeholder="Search..." value="<%= query.q || '' %>">
    <!-- Autocomplete: the browser suggests matching item names from this
         <datalist> as you type — no fetch, no JavaScript. -->
    <datalist id="item-names">
      <% itemNames.forEach(name => { %>
        <option value="<%= name %>">
      <% }) %>
    </datalist>

    <select name="category">
      <option value="">All categories</option>
      <option <%= query.category === 'Electronics' ? 'selected' : '' %>>Electronics</option>
      <option <%= query.category === 'Clothing' ? 'selected' : '' %>>Clothing</option>
      <option <%= query.category === 'Documents' ? 'selected' : '' %>>Documents</option>
      <option <%= query.category === 'Accessories' ? 'selected' : '' %>>Accessories</option>
      <option <%= query.category === 'Bags' ? 'selected' : '' %>>Bags</option>
      <option <%= query.category === 'Others' ? 'selected' : '' %>>Others</option>
    </select>
    <select name="status">
      <option value="">Any status</option>
      <option value="unclaimed" <%= query.status === 'unclaimed' ? 'selected' : '' %>>Unclaimed</option>
      <option value="claimed" <%= query.status === 'claimed' ? 'selected' : '' %>>Claimed</option>
      <option value="removed" <%= query.status === 'removed' ? 'selected' : '' %>>Removed</option>
    </select>

    <!-- Date range filter on date_found — the main way to reach items
         older than 30 days that are hidden from the default Browse page -->
    <label style="font-size:0.85rem; color:var(--text-muted); align-self:center; margin:0;">From</label>
    <input type="date" name="date_from" value="<%= query.date_from || '' %>" style="width:auto;">
    <label style="font-size:0.85rem; color:var(--text-muted); align-self:center; margin:0;">To</label>
    <input type="date" name="date_to" value="<%= query.date_to || '' %>" style="width:auto;">

    <button type="submit" class="btn">Search</button>
  </form>

  <% if (recentSearches.length > 0) { %>
    <p style="font-size:0.9rem; color:var(--text-muted);">
      Recent searches:
      <% recentSearches.forEach(term => { %>
        <a href="/items/search?q=<%= encodeURIComponent(term) %>" style="margin-right:0.75rem;"><%= term %></a>
      <% }) %>
    </p>
  <% } %>

  <!-- Same item-card layout as Hui Xing's Browse page (views/items/index.ejs)
       so search results and the browse list look identical — thumbnail,
       name/meta, status badge, View button. -->
  <ul class="item-list">
    <% items.forEach(item => { %>
      <li class="item-card">
        <% if (item.image) { %>
          <img src="/images/<%= item.image %>" alt="<%= item.item_name %>" class="item-thumb">
        <% } else { %>
          <div class="item-thumb item-thumb-placeholder">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
            </svg>
          </div>
        <% } %>
        <div class="item-info">
          <div class="item-name"><%= item.item_name %></div>
          <div class="item-meta"><%= item.category %> &middot; <%= item.location_found %> &middot; <%= item.date_found %></div>
        </div>
        <span class="status-badge status-<%= item.status %>"><%= item.status %></span>
        <a href="/items/<%= item.item_id %>" class="btn btn-sm">View</a>
      </li>
    <% }) %>
  </ul>
  <% if (items.length === 0) { %>
    <div class="empty-state">
      <p>No items match your search.</p>
    </div>
  <% } %>
<%- include('../partials/footer') %>
