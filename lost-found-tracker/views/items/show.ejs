<%- include('../partials/header') %>
  <div class="card">
    <!-- Hui Xing: renders the `item` passed in from the GET /items/:id
         route in app.js, plus the role-gated action buttons that hand off
         to Soe San's edit route, Wei Qi's delete route, and Wei Qi's claim
         form (only one of these should ever show for a given user/status). -->
    <h1><%= item.item_name %></h1>
    <% if (item.image) { %>
      <!-- Shernice's Image Upload feature: display-only here, since the
         upload itself only happens at creation time. -->
      <img src="/images/<%= item.image %>" alt="<%= item.item_name %>" style="max-width:100%; border-radius:var(--radius); margin-bottom:1rem;">
    <% } %>
    <p class="status-badge status-<%= item.status %>"><%= item.status %></p>
    <p><%= item.description %></p>
    <p><strong>Location:</strong> <%= item.location_found %></p>
    <p><strong>Date found:</strong> <%= item.date_found %></p>
    <p><strong>Reported by:</strong> <%= item.reported_by_username %></p>

    <!-- Same rule as app.js's canEditItem: staff/admin can edit any item;
         a student only sees Edit on the item they themselves reported. -->
    <% if (user && (user.role === 'staff' || user.role === 'admin' || item.reported_by === user.user_id)) { %>
      <a href="/items/<%= item.item_id %>/edit" class="btn">Edit</a>
    <% } %>
    <% if (user && (user.role === 'staff' || user.role === 'admin')) { %>
      <% if (item.status === 'removed') { %>
        <!-- Restore button -->
        <form action="/items/<%= item.item_id %>/restore" method="POST" style="display:inline;">
          <button type="submit" class="btn btn-secondary">Restore</button>
        </form>
      <% } else if (item.status !== 'claimed' && item.status !== 'pending') { %>
        <!-- Delete button triggers modal — not offered on 'pending' items
             either, same reasoning as 'claimed': it's already resolved
             (owner confirmed), just waiting on physical pickup. -->
        <button type="button" class="btn btn-danger" onclick="openDeleteModal('<%= item.item_id %>')">
          Delete
        </button>
      <% } %>
      <% if (item.status === 'pending') { %>
        <!-- Wei Qi — Claim Verification Workflow: the owner has been
             confirmed (claim approved) but hasn't physically picked the
             item up from the hub yet. This is the step that finally moves
             it to 'claimed'. -->
        <form action="/items/<%= item.item_id %>/collect" method="POST" style="display:inline;">
          <button type="submit" class="btn">Mark as collected</button>
        </form>
      <% } %>
    <% } %>

    <% if (user && user.role === 'student' && item.status === 'unclaimed') { %>
      <% if (alreadyClaimed) { %>
        <p style="color:var(--success); font-weight:600;">✓ Your claim has been submitted. Staff will review it shortly.</p>
      <% } else { %>
        <a href="/items/<%= item.item_id %>/claim" class="btn">Claim this item</a>
      <% } %>
    <% } %>
  </div>

<!-- Delete confirmation modal -->
  <div id="deleteModal" class="modal" style="display:none;">
    <div class="modal-content">
      <h3>Confirm Delete</h3>
      <p>Type <strong class="delete-text">delete</strong> to confirm removal: <%= item.item_name %></p>
      <form id="deleteForm" method="POST">
        <input type="text" name="confirmText" placeholder="Type delete here" required>
        <div class="modal-actions">
          <button type="submit" class="btn btn-danger">Delete</button>
          <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">Cancel</button>
        </div>
      </form>
    </div>
  </div>
<%- include('../partials/footer') %>

<!-- Deliberate, single exception to this app's no-client-JS rule (every
     other feature manages with plain forms/links — e.g. autocomplete uses a
     native <datalist> instead of JS specifically to avoid this). Justified
     here because it's a safety confirmation in front of a destructive,
     irreversible-feeling action (Delete), not app logic. -->
<script>
function openDeleteModal(itemId) {
  const modal = document.getElementById('deleteModal');
  const form = document.getElementById('deleteForm');
  form.action = `/items/${itemId}/delete`; // set correct action
  modal.style.display = 'flex';
}
function closeDeleteModal() {
  document.getElementById('deleteModal').style.display = 'none';
}
</script>

<style>
.modal {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.5);
  display: flex; align-items: center; justify-content: center;
}
.modal-content {
  background: white;
  padding: 20px;
  border-radius: 8px;
  width: 400px; /* wider box */
  text-align: center;
}
.modal-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 15px;
}
.modal-actions .btn {
  flex: 1;
  margin: 0 5px;
}
.delete-text {
  color: red;
  font-weight: bold;
}
</style>
