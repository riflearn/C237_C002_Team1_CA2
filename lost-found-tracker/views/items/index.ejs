<%- include('../partials/header') %>

<div class="browse-hero">
  <div class="browse-hero-inner">
    <h1 class="browse-title">Found Items</h1>
  </div>
</div>

<div class="container">
  <% if (success === 'restored') { %>
    <p class="success">Item restored — it's back to Unclaimed.</p>
  <% } %>

  <!-- Search bar, right here on Browse instead of behind a separate page —
       submits straight into Jun Hao's existing GET /items/search with the
       same field names her Search page form uses, so her route/query logic
       is completely untouched; this is a view-only addition. The status
       filter is still left out (Browse's tabs above already filter by
       status — showing both here would just be a second, redundant status
       control). Autocomplete + Recent Searches ARE included here too now —
       GET /items runs the same two queries Jun Hao's /items/search route
       does, so this box behaves identically instead of silently doing less
       than the dedicated Search page. -->
  <form class="filters" action="/items/search" method="GET">
    <input type="text" name="q" list="item-names" placeholder="Search items..." autocomplete="off">
    <datalist id="item-names">
      <% itemNames.forEach(name => { %>
        <option value="<%= name %>">
      <% }) %>
    </datalist>
    <select name="category">
      <option value="">All categories</option>
      <option>Electronics</option>
      <option>Clothing</option>
      <option>Documents</option>
      <option>Accessories</option>
      <option>Bags</option>
      <option>Others</option>
    </select>
    <label style="font-size:0.85rem; color:var(--text-muted); align-self:center; margin:0;">From</label>
    <input type="date" name="date_from" style="width:auto;">
    <label style="font-size:0.85rem; color:var(--text-muted); align-self:center; margin:0;">To</label>
    <input type="date" name="date_to" style="width:auto;">
    <button type="submit" class="btn">Search</button>
  </form>

  <% if (recentSearches.length > 0) { %>
    <p style="font-size:0.9rem; color:var(--text-muted);">
      Recent searches:
      <% recentSearches.forEach(term => { %>
        <a href="/items/search?q=<%= encodeURIComponent(term) %>" style="margin-right:0.75rem;"><%= term %></a>
      <% }) %>
    </p>
  <% } %>

  <!-- Hui Xing — Status tabs: Unclaimed, Pending Collection (Wei Qi's
       claim-approved-but-not-collected state), and Claimed, for everyone.
       Staff/admin also get a Removed tab (Wei Qi's soft-delete). -->
  <div class="status-tabs">
    <a href="/items?status=unclaimed&sort=<%= sort %>&dir=<%= dir %>"
       class="tab-link <%= activeStatus === 'unclaimed' ? 'tab-active' : '' %>">
      Unclaimed
    </a>
    <a href="/items?status=pending&sort=<%= sort %>&dir=<%= dir %>"
       class="tab-link <%= activeStatus === 'pending' ? 'tab-active' : '' %>">
      Pending Collection
    </a>
    <a href="/items?status=claimed&sort=<%= sort %>&dir=<%= dir %>"
       class="tab-link <%= activeStatus === 'claimed' ? 'tab-active' : '' %>">
      Claimed
    </a>
    <% if (user && (user.role === 'staff' || user.role === 'admin')) { %>
      <a href="/items?status=removed"
        class="tab-link <%= activeStatus === 'removed' ? 'tab-active' : '' %>">
        Removed
      </a>
    <% } %>
  </div>

  <!-- Hui Xing — Sort buttons: active sort is highlighted, resets page to 1 -->
  <div class="sort-bar">
    <span class="sort-label">Sort by</span>
    <a href="/items?status=<%= activeStatus %>&sort=created_at&dir=desc"
       class="sort-btn <%= sort === 'created_at' ? 'sort-btn-active' : '' %>">Newest</a>
    <a href="/items?status=<%= activeStatus %>&sort=date_found&dir=desc"
       class="sort-btn <%= sort === 'date_found' ? 'sort-btn-active' : '' %>">Date Found</a>
    <a href="/items?status=<%= activeStatus %>&sort=item_name&dir=asc"
       class="sort-btn <%= sort === 'item_name' ? 'sort-btn-active' : '' %>">Name (A–Z)</a>
    <span class="browse-period-note">Showing last 30 days &middot; <a href="/items/search">See all &rarr;</a></span>
  </div>

  <!-- Item list -->
  <ul class="item-list">
    <% items.forEach(item => { %>
      <li class="item-card">
        <% if (item.image) { %>
          <img src="/images/<%= item.image %>" alt="<%= item.item_name %>" class="item-thumb">
        <% } else { %>
          <div class="item-thumb item-thumb-placeholder">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z"/>
            </svg>
          </div>
        <% } %>
        <div class="item-info">
          <div class="item-name"><%= item.item_name %> <span class="id-tag">#<%= item.item_id %></span></div>
          <div class="item-meta"><%= item.category %> &middot; <%= item.location_found %> &middot; <%= item.date_found %></div>
          <div class="item-meta">Reported by <%= item.reported_by_username %></div>
        </div>
        <span class="status-badge status-<%= item.status %>"><%= item.status %></span>
        <a href="/items/<%= item.item_id %>" class="btn btn-sm">View</a>
      </li>
    <% }) %>
  </ul>

  <% if (items.length === 0) { %>
    <div class="empty-state">
      <p>No <%= activeStatus %> items in the last 30 days.</p>
      <p style="font-size:0.85rem; margin-top:0.5rem;">
        Looking for older items? <a href="/items/search">Use Search &amp; Filter &rarr;</a>
      </p>
    </div>
  <% } %>

  <!-- Hui Xing — Pagination: carries status + sort/dir forward -->
  <div class="pagination">
    <% if (page > 1) { %>
      <a href="/items?status=<%= activeStatus %>&page=<%= page - 1 %>&sort=<%= sort %>&dir=<%= dir %>" class="page-btn">&larr; Prev</a>
    <% } %>
    <span class="page-info">Page <%= page %> of <%= totalPages %></span>
    <% if (page < totalPages) { %>
      <a href="/items?status=<%= activeStatus %>&page=<%= page + 1 %>&sort=<%= sort %>&dir=<%= dir %>" class="page-btn">Next &rarr;</a>
    <% } %>
  </div>

  <% if (user) { %>
    <div style="margin-top: 1.5rem;">
      <a href="/items/new" class="btn">+ Report a found item</a>
    </div>
  <% } %>

</div>

<%- include('../partials/footer') %>
