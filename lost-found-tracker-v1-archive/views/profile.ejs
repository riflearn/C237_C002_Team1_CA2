<%- include('partials/header') %>
  <!-- Firdaus — My Profile / Account Settings: view/edit your own account.
       Only ever reads or writes the logged-in user's own row. -->
  <div class="card" style="max-width:420px; margin: 2rem auto;">
    <h1>My Profile</h1>
    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <% if (success) { %>
      <p class="status-badge status-claimed"><%= success %></p>
    <% } %>

    <form action="/profile" method="POST">
      <label for="username">Username</label>
      <input type="text" id="username" value="<%= profileUser.username %>" disabled>

      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= profileUser.email %>" required>

      <label for="role">Role</label>
      <input type="text" id="role" value="<%= profileUser.role %>" disabled>

      <hr>
      <p style="font-size:0.9rem; color:var(--text-muted);">Leave the password fields blank to keep your current password.</p>

      <label for="current_password">Current password</label>
      <input type="password" id="current_password" name="current_password">

      <label for="new_password">New password</label>
      <input type="password" id="new_password" name="new_password">

      <button type="submit" class="btn">Save changes</button>
    </form>
  </div>
<%- include('partials/footer') %>
