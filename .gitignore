# Dependencies (each person runs npm install locally)
node_modules/

# Local secrets — every teammate has their own .env, never committed
.env

# Assignment paperwork (spec, development journal, technical plan,
# presentation slides) — course/personal documents, not code, submitted
# separately via LMS / presented directly, not shipped in this repo.
*.docx
*.pdf
*.pptx

# Snapshot/backup zips (e.g. lost-found-tracker.zip) — these can contain a
# full copy of node_modules and the real .env with live credentials in it.
*.zip

# Personal presentation/study prep — not part of the app, not shared via repo.
presentation-prep/

# Claude session-continuity notes — for re-orienting after context
# compaction, not part of the app, not shared via repo.
claude-notes/
