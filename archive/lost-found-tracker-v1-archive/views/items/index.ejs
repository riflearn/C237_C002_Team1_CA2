<%- include('../partials/header') %>
  <h1>Found Items</h1>

  <!-- Hui Xing: search/filter now lives on its own page (Jun Hao's) —
       this page is a plain browse list. -->
  <p><a href="/items/search" class="btn">Search &amp; Filter &rarr;</a></p>

  <!-- Hui Xing — Sorting: each link sets ?sort=/?dir= in the URL, read
       and validated against an allowlist in app.js's GET /items. -->
  <p style="font-size:0.9rem;">
    Sort by:
    <a href="/items?sort=created_at&dir=desc">Newest</a> &middot;
    <a href="/items?sort=date_found&dir=desc">Date found</a> &middot;
    <a href="/items?sort=item_name&dir=asc">Name (A-Z)</a> &middot;
    <a href="/items?sort=status&dir=asc">Status</a>
  </p>

  <ul class="item-list">
    <% items.forEach(item => { %>
      <li>
        <% if (item.image) { %>
          <img src="/images/<%= item.image %>" alt="<%= item.item_name %>" style="width:56px; height:56px; object-fit:cover; border-radius:var(--radius);">
        <% } %>
        <div>
          <strong><%= item.item_name %></strong> — <%= item.category %>
          <div style="font-size:0.85rem; color:var(--text-muted);">
            <%= item.location_found %> &middot; <%= item.date_found %>
          </div>
        </div>
        <span class="status-badge status-<%= item.status %>"><%= item.status %></span>
        <a href="/items/<%= item.item_id %>" class="btn">View</a>
      </li>
    <% }) %>
  </ul>
  <% if (items.length === 0) { %>
    <p>No items to show.</p>
  <% } %>

  <!-- Hui Xing — Pagination: carries the current sort/dir forward so
       paging doesn't reset the sort order. -->
  <p>
    <% if (page > 1) { %>
      <a href="/items?page=<%= page - 1 %>&sort=<%= sort %>&dir=<%= dir %>">&larr; Prev</a>
    <% } %>
    Page <%= page %> of <%= totalPages %>
    <% if (page < totalPages) { %>
      <a href="/items?page=<%= page + 1 %>&sort=<%= sort %>&dir=<%= dir %>">Next &rarr;</a>
    <% } %>
  </p>

  <a href="/items/new" class="btn">+ Report a found item</a>
<%- include('../partials/footer') %>
