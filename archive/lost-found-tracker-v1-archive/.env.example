# Copy this file to .env and fill in your own local values.
# .env is gitignored — never commit the real .env file to GitHub.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=lost_found_tracker
# Set to true only if DB_HOST is a cloud MySQL instance (e.g. Azure Database
# for MySQL) that requires an encrypted connection. Leave unset/false for
# local MySQL.
DB_SSL=false

SESSION_SECRET=change_this_to_a_random_string

PORT=3000
